import argparse

from cliff.app import App

class Command:
    app: App
    app_args: list[str] | None
    cmd_name: str | None

    def __init__(self, app: App, app_args: list[str] | None, cmd_name: str | None = None) -> None: ...
    def get_description(self) -> str: ...
    def get_parser(self, prog_name: str) -> argparse.ArgumentParser: ...
    def take_action(self, parsed_args: argparse.Namespace) -> object: ...
    def run(self, parsed_args: argparse.Namespace) -> int: ...
